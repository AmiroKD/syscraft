{
  "model_version": "v39",
  "entities": [
    {
      "entity": "lending_record",
      "class_name": "LendingRecord",
      "display_name": "图书借阅登记",
      "owner_field": null,
      "fields": [
        {
          "column": "id",
          "property": "id",
          "type": "BIGINT",
          "primary_key": true,
          "nullable": false,
          "unique": true,
          "semantic": "主键",
          "visibility": "PLAIN",
          "sensitive": false
        },
        {
          "column": "book_title",
          "property": "bookTitle",
          "type": "VARCHAR",
          "primary_key": false,
          "nullable": false,
          "unique": false,
          "semantic": "书名，借阅登记时填写",
          "visibility": "PLAIN",
          "sensitive": false,
          "length": 100
        },
        {
          "column": "book_code",
          "property": "bookCode",
          "type": "VARCHAR",
          "primary_key": false,
          "nullable": false,
          "unique": false,
          "semantic": "图书编号，标识所借图书（同一编号可出现于多条历史记录）",
          "visibility": "PLAIN",
          "sensitive": false,
          "length": 50
        },
        {
          "column": "borrower",
          "property": "borrower",
          "type": "VARCHAR",
          "primary_key": false,
          "nullable": false,
          "unique": false,
          "semantic": "借阅人姓名",
          "visibility": "PLAIN",
          "sensitive": false,
          "length": 50
        },
        {
          "column": "borrow_date",
          "property": "borrowDate",
          "type": "DATE",
          "primary_key": false,
          "nullable": false,
          "unique": false,
          "semantic": "借出日期",
          "visibility": "PLAIN",
          "sensitive": false
        },
        {
          "column": "return_date",
          "property": "returnDate",
          "type": "DATE",
          "primary_key": false,
          "nullable": true,
          "unique": false,
          "semantic": "归还日期，未归还时为空",
          "visibility": "PLAIN",
          "sensitive": false
        },
        {
          "column": "status",
          "property": "status",
          "type": "VARCHAR",
          "primary_key": false,
          "nullable": false,
          "unique": false,
          "semantic": "借阅状态：借出／已归还／逾期",
          "visibility": "PLAIN",
          "sensitive": false,
          "length": 20
        },
        {
          "column": "created_at",
          "property": "createdAt",
          "type": "DATETIME",
          "primary_key": false,
          "nullable": false,
          "unique": false,
          "semantic": "创建时间",
          "visibility": "PLAIN",
          "sensitive": false
        }
      ],
      "rules": {
        "computed": [],
        "constraints": [],
        "states": []
      }
    }
  ],
  "grants": [
    {
      "role": "USER",
      "entity": "lending_record",
      "access": "READ"
    }
  ],
  "assumptions": [
    "需求仅涉及借阅登记，故只建一张借阅登记表，不另建图书主数据表与读者主数据表。",
    "同一本图书可被多次借阅，因此 book_code 不做唯一约束，历史记录以多条 lending_record 留存。",
    "return_date 为空即表示尚未归还；登记归还时写入实际归还日期。",
    "逾期状态由系统按“未归还且已过应还期限”判定，不额外存储应还日期字段（如需，可后续扩展 due_date）。",
    "借阅人仅记录姓名文本，不做账号校验与信用管理。",
    "建议角色未自动创建（是否创建由用户确认）；内置 USER 角色默认只读，写入权需管理员显式上调"
  ]
}