{
  "version": 1,
  "modelVersion": "v10",
  "accounts": [
    {
      "role": "SUPER_ADMIN",
      "username": "__acc_admin__",
      "usernameRef": "env:ADMIN_USER",
      "passwordRef": "env:ADMIN_INIT_PWD"
    },
    {
      "role": "USER",
      "username": "__acc_user__",
      "passwordRef": "env:ACC_USER_PWD"
    }
  ],
  "cases": [
    {
      "id": "health",
      "category": "service",
      "level": "block",
      "title": "健康检查为 UP",
      "check": {
        "type": "health",
        "path": "/actuator/health"
      }
    },
    {
      "id": "endpoints-activity_info",
      "category": "interface",
      "level": "block",
      "title": "活动 五个端点均存在",
      "suspects": [
        "src/main/java/com/generated/generated/controller/ActivityInfoController.java"
      ],
      "check": {
        "type": "endpoints",
        "base": "/api/biz/activity_info",
        "ops": [
          "query",
          "aggregate",
          "insert",
          "update",
          "delete"
        ]
      }
    },
    {
      "id": "crud-activity_info",
      "category": "interface",
      "level": "block",
      "title": "活动 增删改查往返一致",
      "suspects": [
        "src/main/java/com/generated/generated/service/ActivityInfoService.java"
      ],
      "check": {
        "type": "crud",
        "base": "/api/biz/activity_info",
        "entity": "activity_info",
        "account": "__acc_admin__",
        "sample": {
          "activity_name": "Tactivity",
          "start_time": "2026-11-09T10:00:00",
          "location": "Tlocation",
          "capacity": 2,
          "created_at": "2026-11-09T10:00:00"
        }
      }
    },
    {
      "id": "endpoints-activity_signup",
      "category": "interface",
      "level": "block",
      "title": "报名记录 五个端点均存在",
