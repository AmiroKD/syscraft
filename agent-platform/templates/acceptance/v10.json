      ],
      "check": {
        "type": "endpoints",
        "base": "/api/biz/activity_signup",
        "ops": [
          "query",
          "aggregate",
          "insert",
          "update",
          "delete"
        ]
      }
    },
    {
      "id": "crud-activity_signup",
      "category": "interface",
      "level": "block",
      "title": "报名记录 增删改查往返一致",
      "suspects": [
        "src/main/java/com/generated/generated/service/ActivitySignupService.java"
      ],
      "check": {
        "type": "crud",
        "base": "/api/biz/activity_signup",
        "entity": "activity_signup",
        "account": "__acc_admin__",
        "sample": {
          "activity_info_id": 2,
          "signer_name": "TsignerNa",
          "contact": "Tcontact",
          "signup_time": "2026-11-09T10:00:00",
          "created_at": "2026-11-09T10:00:00"
        }
      }
    },
    {
