    // ----------------------------------------------------------- 规则段（状态机）

    private void checkTransition({{ class_name }} existing, {{ class_name }} incoming) {
        if (incoming.get{{ state_rule.getter }}() == null
                || Objects.equals(incoming.get{{ state_rule.getter }}(), existing.get{{ state_rule.getter }}())) {
            return;
        }
        int from = {{ state_rule.constant }}.indexOf(existing.get{{ state_rule.getter }}());
        int to = {{ state_rule.constant }}.indexOf(incoming.get{{ state_rule.getter }}());
        if (from < 0 || to != from + 1) {
            throw new BizException(ErrorCode.CONFLICT,
                    "非法状态流转：" + existing.get{{ state_rule.getter }}() + " → " + incoming.get{{ state_rule.getter }}());
        }
    }
{% endif %}

    // ---------------------------------------------------------------- 条件装配

    private void applyFilter(LambdaQueryWrapper<{{ class_name }}> wrapper, FilterGroup filter) {
        if (filter == null || filter.conditions() == null || filter.conditions().isEmpty()) {
            return;
        }
        if (filter.isOr()) {
            wrapper.and(inner -> {
                List<Cond> conditions = filter.conditions();
                for (int i = 0; i < conditions.size(); i++) {
                    if (i > 0) {
                        inner.or();
                    }
                    applyOne(inner, conditions.get(i));
                }
            });
            return;
        }
        for (Cond cond : filter.conditions()) {
            applyOne(wrapper, cond);
        }
    }

    /** 字段名 → 方法引用。写死在这里，字段改名时编译期就会报错 */
    private void applyOne(LambdaQueryWrapper<{{ class_name }}> wrapper, Cond cond) {
        if (cond == null || cond.field() == null) {
            return;
        }
        switch (cond.field()) {
{% for f in fields %}
            case "{{ f.column }}" -> QueryOps.apply(wrapper, {{ class_name }}::get{{ f.getter }}, cond);
{% endfor %}
            default -> throw new BizException(ErrorCode.BAD_REQUEST, "未知查询字段：" + cond.field());
        }
    }

    private void applyOrder(LambdaQueryWrapper<{{ class_name }}> wrapper, List<OrderBy> orderBy) {
        if (orderBy == null || orderBy.isEmpty()) {
            return;
        }
        for (OrderBy item : orderBy) {
            if (item == null || item.field() == null) {
                continue;
            }
            switch (item.field()) {
{% for f in fields %}
                case "{{ f.column }}" -> {
                    if (item.isDesc()) {
                        wrapper.orderByDesc({{ class_name }}::get{{ f.getter }});
                    } else {
                        wrapper.orderByAsc({{ class_name }}::get{{ f.getter }});
                    }
                }
{% endfor %}
                default -> throw new BizException(ErrorCode.BAD_REQUEST, "未知排序字段：" + item.field());
            }
        }
    }

    private void applyStringFilter(QueryWrapper<{{ class_name }}> wrapper, FilterGroup filter) {
        if (filter == null || filter.conditions() == null) {
            return;
        }
        for (Cond cond : filter.conditions()) {
            if (cond == null || cond.field() == null) {
                continue;
            }
            QueryOps.apply(wrapper, columnOf(cond.field(), "查询"), cond);
        }
    }

    private String columnOf(String field, String usage) {
        String column = COLUMN.get(field);
        if (column == null) {
            throw new BizException(ErrorCode.BAD_REQUEST, "未知" + usage + "字段：" + field);
        }
        return column;
    }

