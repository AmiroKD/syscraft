        "src/main/java/com/generated/generated/controller/DeviceLedgerController.java"
      ],
      "check": {
        "type": "endpoints",
        "base": "/api/biz/device_ledger",
        "ops": [
          "query",
          "aggregate",
          "insert",
          "update",
          "delete"
        ]
      }
    },
    {
