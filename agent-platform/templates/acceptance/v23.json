{
  "version": 1,
  "modelVersion": "v23",
  "accounts": [
    {
      "role": "SUPER_ADMIN",
      "username": "__acc_admin__",
      "usernameRef": "env:ADMIN_USER",
      "passwordRef": "env:ADMIN_INIT_PWD"
    },
    {
      "role": "USER",
      "username": "__acc_user__",
      "passwordRef": "env:ACC_USER_PWD"
    }
  ],
  "cases": [
    {
      "id": "health",
      "category": "service",
      "level": "block",
      "title": "健康检查为 UP",
      "check": {
        "type": "health",
        "path": "/actuator/health"
      }
    },
    {
      "id": "endpoints-member",
      "category": "interface",
      "level": "block",
      "title": "社团会员 五个端点均存在",
      "suspects": [
        "src/main/java/com/generated/generated/controller/MemberController.java"
      ],
      "check": {
        "type": "endpoints",
        "base": "/api/biz/member",
        "ops": [
          "query",
          "aggregate",
          "insert",
          "update",
          "delete"
        ]
      }
    },
    {
      "id": "crud-member",
      "category": "interface",
      "level": "block",
      "title": "社团会员 增删改查往返一致",
      "suspects": [
        "src/main/java/com/generated/generated/service/MemberService.java"
      ],
      "check": {
        "type": "crud",
        "base": "/api/biz/member",
        "entity": "member",
        "account": "__acc_admin__",
        "updatableField": "department",
        "sample": {
          "name": "Tname",
          "student_no": "TstudentN",
          "department": "Tdepartme",
          "join_date": "2026-11-09",
          "created_at": "2026-11-09T10:00:00"
        }
      }
    },
    {
      "id": "endpoints-payment_record",
      "category": "interface",
      "level": "block",
      "title": "缴费记录 五个端点均存在",
      "suspects": [
        "src/main/java/com/generated/generated/controller/PaymentRecordController.java"
      ],
      "check": {
        "type": "endpoints",
        "base": "/api/biz/payment_record",
        "ops": [
          "query",
          "aggregate",
          "insert",
          "update",
          "delete"
        ]
      }
    },
    {
      "id": "crud-payment_record",
      "category": "interface",
      "level": "block",
      "title": "缴费记录 增删改查往返一致",
      "suspects": [
        "src/main/java/com/generated/generated/service/PaymentRecordService.java"
      ],
      "check": {
        "type": "crud",
        "base": "/api/biz/payment_record",
        "entity": "payment_record",
        "account": "__acc_admin__",
        "updatableField": null,
        "sample": {
          "member_id": 2,
          "amount": null,
          "pay_date": "2026-11-09",
          "is_received": true,
          "created_at": "2026-11-09T10:00:00"
        }
      }
    },
    {
      "id": "confirm-reuse",
      "category": "confirm",
      "level": "block",
      "title": "同一确认令牌不能核销两次",
      "suspects": [
        "src/main/java/com/generated/platform/confirm/ConfirmService.java"
      ],
      "check": {
        "type": "confirmReuse",
        "base": "/api/biz/member",
        "entity": "member",
        "account": "__acc_admin__",
        "sample": {
          "name": "Tname",
          "student_no": "TstudentN",
          "department": "Tdepartme",
          "join_date": "2026-11-09",
          "created_at": "2026-11-09T10:00:00"
        },
        "unique_fields": [
          "student_no"
        ]
      }
    },
    {
      "id": "auth-401",
      "category": "permission",
      "level": "block",
      "title": "无令牌访问返回 401",
      "suspects": [
        "src/main/java/com/generated/platform/security/SaTokenConfig.java"
      ],
      "check": {
        "type": "status",
        "path": "/api/biz/member/query",
        "expect": 401,
        "auth": "none"
      }
    },
    {
      "id": "perm-403",
      "category": "permission",
      "level": "block",
      "title": "普通用户删除未经授权返回 403",
      "suspects": [
        "src/main/java/com/generated/platform/security/PermissionCodeResolver.java"
      ],
      "check": {
        "type": "status",
        "path": "/api/biz/member/delete",
        "expect": 403,
        "auth": "__acc_user__",
        "auth_body": {
          "ids": [
            1
          ]
        }
      }
    },
    {
      "id": "perm-200",
