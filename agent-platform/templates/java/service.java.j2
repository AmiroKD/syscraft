    @Transactional
    public Long insert({{ class_name }} entity) {
        if (entity == null) {
            throw new BizException(ErrorCode.BAD_REQUEST, "请求体不能为空");
        }
        validate(entity);
        applyComputed(entity);
        mapper.insert(entity);
        return entity.getId();
    }

    @Transactional
    public void update({{ class_name }} entity) {
        if (entity == null || entity.getId() == null) {
            throw new BizException(ErrorCode.BAD_REQUEST, "更新必须带主键 id");
        }
        {{ class_name }} existing = mapper.selectById(entity.getId());
        if (existing == null) {
            throw new BizException(ErrorCode.NOT_FOUND, "记录不存在：" + entity.getId());
        }
        validate(entity);
        applyComputed(entity);
{% if state_rule %}
        checkTransition(existing, entity);
{% endif %}
        mapper.updateById(entity);
    }

    /**
     * 删除是高危操作：必须先拿预告令牌（权限 4.7）。流程固定为
     * 核销令牌（抢占，防并发重复提交）→ 审计 INTENT → 删除 → 审计回填 → 令牌 CONSUMED；
     * 业务失败则审计记 FAILED、令牌回退 ISSUED 可重试。
     */
    @Transactional
    public int delete(IdsRequest req) {
        if (req == null || req.ids() == null || req.ids().isEmpty()) {
            throw new BizException(ErrorCode.BAD_REQUEST, "ids 不能为空");
        }
        List<Long> ids = req.ids().stream().filter(Objects::nonNull).distinct().sorted().toList();
        if (ids.isEmpty()) {
            throw new BizException(ErrorCode.BAD_REQUEST, "ids 不能为空");
        }
        String canonical = ids.stream().map(String::valueOf).collect(Collectors.joining(","));
        String tokenHash = confirmService.consume(req.confirmToken(), "DELETE", "{{ entity }}", canonical);

        long auditId = auditService.begin("删除{{ display_name }}", "{{ entity }}", canonical);
        try {
            int rows = mapper.deleteByIds(ids);
            auditService.success(auditId, rows, "{\"ids\":[" + canonical + "]}");
            confirmService.markConsumed(tokenHash);
            return rows;
        } catch (RuntimeException e) {
            String detail = "{\"ids\":[" + canonical + "],\"error\":\""
                    + String.valueOf(e.getMessage()).replace("\"", "'") + "\"}";
            auditService.failed(auditId, detail);
            confirmService.release(tokenHash);
            throw e;
        }
    }

