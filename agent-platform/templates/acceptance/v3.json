{
  "version": 1,
  "modelVersion": "v3",
  "accounts": [
    {
      "role": "SUPER_ADMIN",
      "username": "__acc_admin__",
      "usernameRef": "env:ADMIN_USER",
      "passwordRef": "env:ADMIN_INIT_PWD"
    },
    {
      "role": "USER",
      "username": "__acc_user__",
      "passwordRef": "env:ACC_USER_PWD"
    }
  ],
  "cases": [
    {
      "id": "health",
      "category": "service",
      "level": "block",
      "title": "健康检查为 UP",
      "check": {
        "type": "health",
        "path": "/actuator/health"
      }
    },
    {
      "id": "endpoints-product",
      "category": "interface",
      "level": "block",
      "title": "商品 五个端点均存在",
      "suspects": [
        "src/main/java/com/generated/generated/controller/ProductController.java"
      ],
      "check": {
        "type": "endpoints",
        "base": "/api/biz/product",
        "ops": [
          "query",
          "aggregate",
          "insert",
          "update",
          "delete"
        ]
      }
    },
    {
      "id": "crud-product",
      "category": "interface",
      "level": "block",
      "title": "商品 增删改查往返一致",
      "suspects": [
        "src/main/java/com/generated/generated/service/ProductService.java"
      ],
      "check": {
        "type": "crud",
        "base": "/api/biz/product",
        "entity": "product",
        "account": "__acc_admin__",
        "sample": {
          "name": "Tname",
          "spec": "Tspec",
          "unit_price": 100,
          "stock_qty": 2,
          "warn_threshold": 2,
          "created_at": "2026-11-09T10:00:00"
        }
      }
    },
    {
      "id": "endpoints-stock_in",
      "category": "interface",
      "level": "block",
      "title": "入库单 五个端点均存在",
      "suspects": [
        "src/main/java/com/generated/generated/controller/StockInController.java"
      ],
      "check": {
        "type": "endpoints",
        "base": "/api/biz/stock_in",
        "ops": [
          "query",
          "aggregate",
          "insert",
          "update",
          "delete"
        ]
      }
    },
    {
      "id": "crud-stock_in",
      "category": "interface",
      "level": "block",
      "title": "入库单 增删改查往返一致",
      "suspects": [
        "src/main/java/com/generated/generated/service/StockInService.java"
      ],
      "check": {
        "type": "crud",
        "base": "/api/biz/stock_in",
        "entity": "stock_in",
        "account": "__acc_admin__",
        "sample": {
          "code": "Tcode",
          "operator": "Toperator",
          "qty": 2,
          "in_date": "2026-11-09",
          "product_id": 2,
          "created_at": "2026-11-09T10:00:00"
        }
      }
    },
    {
      "id": "confirm-reuse",
      "category": "confirm",
      "level": "block",
      "title": "同一确认令牌不能核销两次",
      "suspects": [
        "src/main/java/com/generated/platform/confirm/ConfirmService.java"
      ],
      "check": {
        "type": "confirmReuse",
        "base": "/api/biz/product",
        "entity": "product",
        "account": "__acc_admin__",
        "sample": {
          "name": "Tname",
          "spec": "Tspec",
          "unit_price": 100,
          "stock_qty": 2,
          "warn_threshold": 2,
          "created_at": "2026-11-09T10:00:00"
        },
        "unique_fields": []
      }
    },
    {
      "id": "auth-401",
      "category": "permission",
      "level": "block",
      "title": "无令牌访问返回 401",
      "suspects": [
        "src/main/java/com/generated/platform/security/SaTokenConfig.java"
      ],
      "check": {
        "type": "status",
        "path": "/api/biz/product/query",
        "expect": 401,
        "auth": "none"
      }
    },
    {
      "id": "perm-403",
      "category": "permission",
      "level": "block",
      "title": "普通用户删除未经授权返回 403",
      "suspects": [
        "src/main/java/com/generated/platform/security/PermissionCodeResolver.java"
      ],
      "check": {
        "type": "status",
        "path": "/api/biz/product/delete",
        "expect": 403,
        "auth": "__acc_user__",
        "auth_body": {
          "ids": [
            1
          ]
        }
      }
    },
    {
      "id": "perm-200",
      "category": "permission",
      "level": "block",
      "title": "超管查询返回 200",
