        "src/main/java/com/generated/platform/confirm/ConfirmService.java"
      ],
      "check": {
        "type": "confirmReuse",
        "base": "/api/biz/activity",
        "entity": "activity",
        "account": "__acc_admin__",
        "sample": {
          "name": "Tname",
          "start_time": "2026-11-09T10:00:00",
          "end_time": "2026-11-09T10:00:00",
          "location": "Tlocation",
          "capacity": 2,
          "registered_count": 2,
          "created_at": "2026-11-09T10:00:00",
          "remark": "Tremark"
        },
        "unique_fields": []
      }
    },
    {
      "id": "auth-401",
      "category": "permission",
      "level": "block",
      "title": "无令牌访问返回 401",
      "suspects": [
        "src/main/java/com/generated/platform/security/SaTokenConfig.java"
      ],
      "check": {
        "type": "status",
        "path": "/api/biz/activity/query",
        "expect": 401,
        "auth": "none"
      }
    },
    {
      "id": "perm-403",
      "category": "permission",
      "level": "block",
      "title": "普通用户删除未经授权返回 403",
      "suspects": [
        "src/main/java/com/generated/platform/security/PermissionCodeResolver.java"
      ],
      "check": {
        "type": "status",
        "path": "/api/biz/activity/delete",
        "expect": 403,
        "auth": "__acc_user__",
        "auth_body": {
          "ids": [
            1
          ]
        }
      }
    },
    {
      "id": "perm-200",
      "category": "permission",
      "level": "block",
