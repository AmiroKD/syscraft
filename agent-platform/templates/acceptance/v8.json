{
  "version": 1,
  "modelVersion": "v8",
  "accounts": [
    {
      "role": "SUPER_ADMIN",
      "username": "__acc_admin__",
      "usernameRef": "env:ADMIN_USER",
      "passwordRef": "env:ADMIN_INIT_PWD"
    },
    {
      "role": "USER",
      "username": "__acc_user__",
      "passwordRef": "env:ACC_USER_PWD"
    }
  ],
  "cases": [
    {
      "id": "health",
      "category": "service",
      "level": "block",
      "title": "健康检查为 UP",
      "check": {
        "type": "health",
        "path": "/actuator/health"
      }
    },
    {
      "id": "endpoints-activity",
      "category": "interface",
      "level": "block",
      "title": "活动 五个端点均存在",
      "suspects": [
        "src/main/java/com/generated/generated/controller/ActivityController.java"
      ],
      "check": {
        "type": "endpoints",
        "base": "/api/biz/activity",
        "ops": [
          "query",
          "aggregate",
          "insert",
          "update",
          "delete"
        ]
      }
    },
    {
      "id": "crud-activity",
      "category": "interface",
      "level": "block",
      "title": "活动 增删改查往返一致",
      "suspects": [
        "src/main/java/com/generated/generated/service/ActivityService.java"
      ],
      "check": {
        "type": "crud",
        "base": "/api/biz/activity",
        "entity": "activity",
        "account": "__acc_admin__",
        "sample": {
          "name": "Tname",
          "start_time": "2026-11-09T10:00:00",
          "end_time": "2026-11-09T10:00:00",
          "location": "Tlocation",
          "capacity": 2,
          "registered_count": 2,
          "created_at": "2026-11-09T10:00:00",
          "remark": "Tremark"
        }
      }
    },
    {
      "id": "endpoints-signup",
      "category": "interface",
      "level": "block",
      "title": "报名记录 五个端点均存在",
      "suspects": [
        "src/main/java/com/generated/generated/controller/SignupController.java"
      ],
      "check": {
        "type": "endpoints",
        "base": "/api/biz/signup",
        "ops": [
          "query",
          "aggregate",
          "insert",
          "update",
          "delete"
        ]
      }
    },
    {
      "id": "crud-signup",
      "category": "interface",
      "level": "block",
      "title": "报名记录 增删改查往返一致",
      "suspects": [
        "src/main/java/com/generated/generated/service/SignupService.java"
      ],
      "check": {
        "type": "crud",
        "base": "/api/biz/signup",
        "entity": "signup",
        "account": "__acc_admin__",
        "sample": {
          "activity_id": 2,
          "applicant_name": "Tapplican",
          "contact_phone": "TcontactP",
          "status": "Tstatus",
          "remark": "Tremark",
          "created_at": "2026-11-09T10:00:00"
        }
      }
    },
    {
      "id": "confirm-reuse",
      "category": "confirm",
      "level": "block",
      "title": "同一确认令牌不能核销两次",
