        "src/main/java/com/generated/platform/security/PermissionCodeResolver.java"
      ],
      "check": {
        "type": "status",
        "path": "/api/biz/product/query",
        "expect": 200,
        "auth": "__acc_admin__",
        "auth_body": {}
      }
    }
  ]
}