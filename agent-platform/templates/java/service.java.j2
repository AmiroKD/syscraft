    public {{ class_name }}Service({{ class_name }}Mapper mapper, ConfirmService confirmService,
                                   ConfirmExecutorRegistry confirmExecutorRegistry, AuditService auditService) {
        this.mapper = mapper;
        this.confirmService = confirmService;
        this.auditService = auditService;
        // 注册影响行数计算器：确认预告据此算「这次会删多少条」，不用为每个实体手写预告逻辑
        confirmExecutorRegistry.register("{{ entity }}", ids -> {
            if (ids == null || ids.isEmpty()) {
                return 0;
            }
            Long count = mapper.selectCount(
                    Wrappers.<{{ class_name }}>lambdaQuery().in({{ class_name }}::getId, ids));
            return count == null ? 0 : count.intValue();
        });
    }

    // ------------------------------------------------------------------ 查询

    @Transactional(readOnly = true)
    public PageResult<{{ class_name }}VO> query({{ class_name }}Query req) {
        LambdaQueryWrapper<{{ class_name }}> wrapper = Wrappers.lambdaQuery();
        applyFilter(wrapper, req == null ? null : req.filter());

        // total 走独立 COUNT，且必须在加 LIMIT 之前算
        long total = mapper.selectCount(wrapper);

        applyOrder(wrapper, req == null ? null : req.orderBy());

        int page = (req == null || req.page() == null || req.page() < 1) ? 1 : req.page();
        int requested = (req == null || req.size() == null || req.size() < 1) ? DEFAULT_PAGE_SIZE : req.size();
        boolean truncated = requested > MAX_PAGE_SIZE;
        int size = truncated ? MAX_PAGE_SIZE : requested;

        wrapper.last("LIMIT " + size + " OFFSET " + (long) (page - 1) * size);
        List<{{ class_name }}> records = mapper.selectList(wrapper);

        List<{{ class_name }}VO> rows = new ArrayList<>(records.size());
        for ({{ class_name }} record : records) {
            rows.add(toVO(record));
        }
        return new PageResult<>(rows, total, page, size, truncated);
    }

    @Transactional(readOnly = true)
    public List<Map<String, Object>> aggregate(AggregateRequest req) {
        if (req == null) {
            throw new BizException(ErrorCode.BAD_REQUEST, "请求体不能为空");
        }
        if (req.filter() != null && req.filter().isOr()) {
            throw new BizException(ErrorCode.BAD_REQUEST, "聚合暂不支持 OR 条件，请拆成多次查询");
        }
        QueryWrapper<{{ class_name }}> wrapper = new QueryWrapper<>();
        List<String> select = new ArrayList<>();

        if (req.groupBy() != null) {
            for (String field : req.groupBy()) {
                String column = columnOf(field, "分组");
                select.add(column);
                wrapper.groupBy(column);
            }
        }

        List<Metric> metrics = (req.metrics() == null || req.metrics().isEmpty())
                ? List.of(new Metric("COUNT", null, "cnt"))
                : req.metrics();
        for (Metric metric : metrics) {
            select.add(metricSql(metric));
        }
        wrapper.select(select.toArray(new String[0]));

        applyStringFilter(wrapper, req.filter());
        // 结果行数上限进 SQL，不靠调用方自觉
        wrapper.last("LIMIT " + MAX_AGGREGATE_ROWS);
        return mapper.selectMaps(wrapper);
    }

    private String metricSql(Metric metric) {
        String func = (metric.func() == null ? "COUNT" : metric.func().toUpperCase());
        String alias = (metric.alias() == null || metric.alias().isBlank()) ? "m" : metric.alias();
        // 别名会拼进 SQL，只允许安全字符；参数化在这里不适用，只能白名单
        if (!alias.matches("[\\w\\u4e00-\\u9fa5]{1,32}")) {
            throw new BizException(ErrorCode.BAD_REQUEST, "非法的聚合别名：" + alias);
        }
        if ("COUNT".equals(func)) {
            return "COUNT(*) AS `" + alias + "`";
        }
        if (!List.of("SUM", "AVG", "MAX", "MIN").contains(func)) {
            throw new BizException(ErrorCode.BAD_REQUEST, "不支持的聚合函数：" + metric.func());
        }
        return func + "(" + columnOf(metric.field(), "统计") + ") AS `" + alias + "`";
    }

